# Скопируйте этот файл в ".env" и заполните. Файл .env никому не отправляйте!

# --- Telegram-бот ---
# Сейчас бот ВЫКЛЮЧЕН. Чтобы включить: поставьте BOT_ENABLED=1 и впишите токен.
BOT_ENABLED=0
# Токен выдаёт @BotFather (команда /newbot)
TELEGRAM_BOT_TOKEN=

# PIN, по которому первый человек становится администратором бота: в боте команда  /admin 1234
ADMIN_PIN=1234

# --- ИИ: anthropic | gemini | ollama | none ---
AI_PROVIDER=anthropic
AI_API_KEY=
# Модель (можно оставить пустым — возьмётся по умолчанию для провайдера)
AI_MODEL=
# Для ollama: адрес сервера
OLLAMA_HOST=http://localhost:11434

# --- Смены ---
# Начало первой смены, длительность смены (часы) и число смен в сутки.
# По кейсу: 2 смены по 8 часов (08:00–16:00 и 16:00–24:00). Круглосуточно по 12 ч: SHIFT_HOURS=12, SHIFT_COUNT=2
SHIFT_START=08:00
SHIFT_HOURS=8
SHIFT_COUNT=2

# --- Прочее ---
# Скорость симулятора (1 = реальное время)
SIM_SPEED=1
# 1 = при первом запуске заполнить базу демо-историей за ~2 суток (чтобы отчёты не были пустыми)
SEED_DEMO=1
# Для запуска на сервере поставьте HOST=0.0.0.0
HOST=127.0.0.1
PORT=8000
